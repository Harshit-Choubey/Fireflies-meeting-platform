# ----- Environment / Secrets -----
.env
.env.local
.env.*.local
*.env

# ----- Python -----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
dist/
build/
*.egg
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
*.sqlite3
*.db

# ----- Node / Next.js -----
node_modules/
.next/
out/
.npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- IDE -----
.idea/
.vscode/settings.json
*.swp
*.swo

# ----- Alembic generated -----
# (keep migrations themselves, only exclude pycache inside)
backend/migrations/__pycache__/
